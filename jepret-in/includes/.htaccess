# Blokir akses web ke isi folder includes/ (logika internal, layout, mailer, auth).
# File di sini hanya untuk di-include oleh kode aplikasi, bukan dibuka lewat URL.
# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
